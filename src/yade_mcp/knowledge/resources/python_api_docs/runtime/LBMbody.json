      "type": "Vector3r",
      "default": "Vector3r::Zero()",
      "description": "Hydrodynamic force, need to be reinitialized (LB unit)"
    },
    {
      "name": "fp",
      "type": "Vector3r",
      "default": "Vector3r::Zero()",
      "description": "Hydrodynamic force (LB unit) at t+0.5dt"
