    {
      "name": "mm",
      "type": "Vector3r",
      "default": "Vector3r::Zero()",
      "description": "Hydrodynamic momentum (LB unit) at t-0.5dt"
    },
    {
      "name": "momentum",
      "type": "Vector3r",
      "default": "Vector3r::Zero()",
      "description": "Hydrodynamic momentum,need to be reinitialized (LB unit)"
    },
    {
      "name": "mp",
      "type": "Vector3r",
      "default": "Vector3r::Zero()",
