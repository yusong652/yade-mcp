{
  "name": "GlExtra_AlphaGraph",
  "category": "engines",
  "parent": "GlExtraDrawer",
  "description": "Display the outer surface defined by alpha contour. Add it to qt.Renderer().extraDrawers. If no instance of TesselationWrapper is provided, the functor will create its own. See :ysrc:`scripts/examples/alphaShapes/GlDrawAlpha.py`.",
  "attributes": [
    {
      "name": "tesselationWrapper",
      "type": "TesselationWrapper",
      "default": "shared_ptr<TesselationWrapper>()",
      "description": "Associated instance of TesselationWrapper."
    },
    {
      "name": "color",
      "type": "Vector3",
      "default": "Vector3r(0.3, 0.3, 0.7)",
      "description": "color"
    },
    {
      "name": "lineWidth",
      "type": "float",
      "default": "3",
      "description": "lineWidth in pixels"
    },
    {
      "name": "radius",
      "type": "float",
      "default": "0",
      "description": "radius of cylinder representation, if null 1/12th of average diameter will be used"
    },
    {
      "name": "lighting",
      "type": "bool",
      "default": "true",
      "description": "lighting of cylinders"
    },
    {
      "name": "wire",
      "type": "bool",
      "default": "false",
      "description": "display as solid cylinders or lines"
    },
    {
      "name": "alpha",
      "type": "float",
      "default": "0.0",
      "description": "alpha value",
      "no_save": true
    },
    {
      "name": "shrinkedAlpha",
      "type": "float",
      "default": "0.0",
      "description": "shrinkedAlpha value",
      "no_save": true
    },
    {
      "name": "fixedAlpha",
      "type": "bool",
      "default": "False",
      "description": "fixedAlpha option",
      "no_save": true
    },
    {
      "name": "dead",
      "type": "bool",
      "default": "false",
      "description": "Deactivate the object (on error/exception).",
      "inherited_from": "GlExtraDrawer"
    }
  ],
  "methods": [
    {
      "name": "refresh",
      "args": [],
      "returns": "None",
      "description": "Refresh internals. Particularly usefull for correct display after the TesselationWrapper is modified externally, not needed if 'wire'=True"
    },
    {
      "name": "dict",
      "args": [],
      "returns": "dict",
      "description": "Return dictionary of attributes.",
      "inherited_from": "Serializable"
    },
    {
      "name": "updateAttrs",
      "args": [
        {
          "name": "arg2",
          "type": "dict"
        }
      ],
      "returns": "None",
      "description": "Update object attributes from given dictionary",
      "inherited_from": "Serializable"
    }
  ]
}