{
  "name": "PDFEngine",
  "category": "engines",
  "parent": "PeriodicEngine",
  "description": "Base class for spectrums calculations. Compute Probability Density Functions of normalStress, shearStress, distance, velocity and interactions in spherical coordinates and write result to a file. Column name format is: Data(theta, phi). Convention used: x: phi = 0, y: theta = 0, z: phi = pi/2",
  "attributes": [
    {
      "name": "filename",
      "type": "str",
      "default": "'PDF.txt'"
    },
    {
      "name": "initRun",
      "type": "bool",
      "default": "False"
    },
    {
      "name": "iterPeriod",
      "type": "int",
      "default": "0"
    },
    {
      "name": "nDo",
      "type": "int",
      "default": "-1"
    },
    {
      "name": "numDiscretizeAnglePhi",
      "type": "int",
      "default": "20"
    },
    {
      "name": "numDiscretizeAngleTheta",
      "type": "int",
      "default": "20"
    },
    {
      "name": "realPeriod",
      "type": "float",
      "default": "0.0"
    },
    {
      "name": "virtPeriod",
      "type": "float",
      "default": "0.0"
    },
    {
      "name": "warnedOnce",
      "type": "bool",
      "default": "False"
    }
  ]
}